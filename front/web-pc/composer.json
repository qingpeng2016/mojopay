{
  "type": "project",
  "name": "zoujingli/thinkadmin",
  "license": "MIT",
  "homepage": "https://thinkadmin.top",
  "description": "Application Development Framework",
  "keywords": [
    "ThinkAdmin",
    "ThinkLibrary"
  ],
  "authors": [
    {
      "name": "Anyon",
      "email": "zoujingli@qq.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "dompdf/dompdf": "^3.0",
    "mpdf/mpdf": "^8.2",
    "phpoffice/phpspreadsheet": "^3.3",
    "symfony/yaml": "^7.3",
    "topthink/think-multi-app": "^1.1",
    "zoujingli/think-library": "^6.0",
    "zoujingli/think-plugs-admin": "^1.0"
  },
  "autoload": {
    "exclude-from-classmap": [
      "/vendor/zoujingli/think-plugs-admin/src/"
    ],
    "psr-0": {
      "": "extend"
    },
    "psr-4": {
      "app\\": "app",
      "think\\admin\\support\\middleware\\": "extend/think-admin-support-middleware/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "zoujingli/think-install": true
    }
  }
}
